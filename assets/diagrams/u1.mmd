flowchart TD
    input["New human message"] --> config["Select thread ID"]
    config --> open["Open SQLite saver context"]
    open --> compile_one["Compile MessagesState graph"]
    compile_one --> load["Load selected thread state"]
    load --> model["Invoke injected chat model"]
    model --> delta["Return new AI message"]
    delta --> merge["Merge messages by ID"]
    merge --> disk["Persist checkpoint in SQLite file"]
    disk --> a["Thread A has its own history"]
    disk --> b["Thread B has its own history"]
    a --> close["Exit context and close connection"]
    b --> close
    close --> worker["Fresh Python process reads file"]
    worker --> proof["Verify saved human inputs"]
    proof --> reopen["Reopen same file with new saver"]
    reopen --> rebuild["Compile new graph"]
    rebuild --> inspect["Verify snapshot and checkpoint ID"]
    inspect --> next["Continue selected thread"]
    next --> result["Assert recall and thread isolation"]
