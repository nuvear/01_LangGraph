# Copy this file to .env. Enter credentials locally; never commit .env.
# Required for LLM exercises. Use a model ID available to your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional LangWatch tracing. Synthetic teaching data only.
LANGWATCH_API_KEY=
LANGWATCH_PROJECT_ID=
LANGWATCH_ENDPOINT=https://app.langwatch.ai

# Optional LangSmith tracing. Choose the endpoint for your account region.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-course
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Keep automatic tracing disabled; examples select backends explicitly.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
